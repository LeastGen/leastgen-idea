[Unit]
Description=Nova Labs Production API Server
Documentation=https://github.com/nova-labs/think-fast
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/opt/nova
Environment="PATH=/opt/nova/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/etc/nova/nova.env

# Process Execution
ExecStart=/opt/nova/.venv/bin/uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8756 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips="*"
ExecReload=/bin/kill -HUP $MAINPID

# Restart Policies & Lifecycle
Restart=always
RestartSec=5s
StartLimitIntervalSec=120s
StartLimitBurst=5
TimeoutStopSec=30s

# Resource Limits
LimitNOFILE=65535
LimitNPROC=4096
TasksMax=4096

# Security Hardening & Isolation
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/nova/data /opt/nova/ideaspark_run /opt/nova/scoop_runs /var/log/nova

# Journal Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-api

[Install]
WantedBy=multi-user.target
