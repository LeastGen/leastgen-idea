# ==============================================================================
# Nova Labs / LeastGen Labs — Production Environment Configuration Template
# File: deploy/.env.production.example
# Copy to: /etc/nova/nova.env (or /opt/nova/.env.production)
# Permissions: chmod 640 /etc/nova/nova.env (owned by root:nova)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=nova
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8756
WORKERS=2
LOG_LEVEL=info

# Absolute paths on production host
PROJECT_ROOT=/opt/nova
RUN_DIR=/opt/nova/ideaspark_run
SCOOP_DIR=/opt/nova/scoop_runs
LOG_DIR=/var/log/nova

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# MANDATORY: Generate a cryptographically secure 64-character hex secret!
# Run: openssl rand -hex 32
# NEVER leave this blank or use default values in production.
OPENRESEARCH_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT

# JWT Token Algorithm and Lifetime
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# Session Cookie Security Flags
# Ensure SESSION_COOKIE_SECURE is true when served behind Nginx with HTTPS
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 3. AI / LLM INFERENCE (OPENROUTER)
# ------------------------------------------------------------------------------
# Required for 12-phase research ideation pipeline and Scoop-Check novelty verification.
# Get production key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Optional model routing overrides (defaults to production verified models)
DEFAULT_LLM_MODEL=google/gemini-2.5-flash
FALLBACK_LLM_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 4. TAP PAYMENTS GATEWAY (BILLING & SUBSCRIPTIONS)
# ------------------------------------------------------------------------------
# Live production credentials from Tap Payments (https://tap.company)
# Switch from sk_test_* to sk_live_* before going live!
TAP_API_KEY=sk_live_REPLACE_WITH_LIVE_TAP_KEY
TAP_MERCHANT_ID=REPLACE_WITH_TAP_MERCHANT_ID

# NOTE: Tap has NO separate webhook signing secret. Webhook authenticity is
# proven via the `hashstring` header (HMAC-SHA256, keyed with TAP_API_KEY).
# See backend/routers/billing.py::_verify_tap_hashstring and
# https://developers.tap.company/docs/webhook ("Validate the webhook").

# Public URL reachable by Tap webhook dispatchers
TAP_POST_URL=https://research.example.com/api/billing/webhook

# ------------------------------------------------------------------------------
# 5. DATABASE CONFIGURATION (SQLITE)
# ------------------------------------------------------------------------------
# Production SQLite database storage path
DATABASE_PATH=/opt/nova/data/ideaflow.db

# SQLite PRAGMA settings (handled automatically by database.py):
# - PRAGMA journal_mode=WAL;
# - PRAGMA synchronous=NORMAL;
# - PRAGMA foreign_keys=ON;

# ------------------------------------------------------------------------------
# 6. CORS & NETWORK ACCESS
# ------------------------------------------------------------------------------
# CRITICAL: In production, specify explicit origins. NEVER use wildcard '*'!
# Comma-separated list of allowed origins:
CORS_ORIGINS=https://research.example.com,https://api.research.example.com

# ------------------------------------------------------------------------------
# 7. CACHE SETTINGS (FOR LEASTGEN-HOSTED SEMANTIC CACHE)
# ------------------------------------------------------------------------------
# Enables local on-disk semantic cache to reduce OpenRouter token consumption
CACHE_ENABLED=true
CACHE_DIR=/opt/leastgen/cache
CACHE_TTL_DAYS=30
CACHE_SIMILARITY_THRESHOLD=0.92

# ==============================================================================
# PRODUCTION SECURITY HARDENING CHECKLIST
# Review and check off all items before promoting to live traffic:
# ==============================================================================
# [ ] 1. SECRETS ROTATION:
#        - Replaced all sk_test_* keys with sk_live_* Tap API keys.
#        - Generated unique 64-char OPENRESEARCH_JWT_SECRET with `openssl rand -hex 32`.
#        - Verified webhook hashstring rejection on tampered payloads
#          (HMAC-SHA256 keyed with TAP_API_KEY; see billing.py).
#        - Stored credentials only in /etc/nova/nova.env with chmod 640 (root:nova).
#
# [ ] 2. NETWORK & PORTS:
#        - Uvicorn binds strictly to 127.0.0.1:8756, NOT 0.0.0.0.
#        - UFW allows only ports 22 (SSH), 80 (HTTP), 443 (HTTPS).
#        - Port 8756 is explicitly blocked from external interfaces.
#        - Alibaba Cloud ECS Security Group allows only TCP 22, 80, 443 inbound.
#
# [ ] 3. TLS & CERTIFICATES:
#        - Let's Encrypt SSL certificate installed via Certbot.
#        - HTTP (port 80) permanently redirects to HTTPS (port 443) with 301.
#        - HSTS header enabled with max-age=31536000 and includeSubDomains.
#        - TLS 1.0 and 1.1 disabled; only TLS 1.2 and 1.3 permitted.
#
# [ ] 4. REVERSE PROXY & STREAMING:
#        - `proxy_buffering off;` configured for SSE / LLM streaming.
#        - `proxy_read_timeout 600s;` enabled for 12-phase pipeline longevity.
#        - Rate limiting zones active for /api/auth/ (5r/m) and /api/pipeline/ (2r/m).
#        - Security headers configured (X-Frame-Options, X-Content-Type-Options, CSP).
#
# [ ] 5. SYSTEMD & SANDBOXING:
#        - Running under dedicated system user `nova` with no login shell.
#        - Systemd sandbox active: NoNewPrivileges=true, ProtectSystem=full, PrivateTmp=true.
#        - ReadWritePaths restricted to /opt/nova/data, run dirs, and /var/log/nova.
#        - Restart policy set to Restart=always with restart burst limits.
#
# [ ] 6. DATABASE & BACKUPS:
#        - SQLite WAL mode active for concurrent read/write throughput.
#        - Automated daily SQLite backup configured via cron / Alibaba Cloud OSS snapshot.
#        - Database directory permissions restricted to user `nova`.
#
# [ ] 7. MONITORING & LOGS:
#        - Logrotate configured for /var/log/nova and Nginx access/error logs.
#        - Systemd journal persistence verified (`journalctl -u nova.service`).
#        - Fail2ban enabled for SSH and Nginx rate-limit violations.
# ==============================================================================
